use TurnTo\SocialCommerce\Block\TurnToConfig;
use TurnTo\SocialCommerce\ViewModel\Widget;

/**
 * @var TurnToConfig $block
 * @var Widget $viewModel
 */
$viewModel = $block->getViewModel();
$widgetUrl = $viewModel->getWidgetUrl();

$initConfig = [
    'ssoBaseUrl' => $block->getUrl('turnto/sso'),
    'logoutUrl' => $block->getUrl('customer/account/logout'),
];
?>
<script>
    (function (window) {
        const turnToConfig = <?= /* @noEscape */ $block->getConfigJson() ?>,
            teaserSelectors = <?= /* @noEscape */ $block->getTeaserSelectorsJson() ?>;

        if (!Object.prototype.hasOwnProperty.call(turnToConfig, 'teaser')) {
            turnToConfig.teaser = {
                showReviews: function () {
                    window.jQuery(teaserSelectors.reviews).click();
                },
                showQa: function () {
                    window.jQuery(teaserSelectors.qa).click();
                }
            };
        }

        window.turnToConfig = turnToConfig;
        window.TurnToCmd = window.TurnToCmd || function () {
            (TurnToCmd.q = TurnToCmd.q || []).push(arguments);
        };
    })(window);
</script>

<script type="text/x-magento-init">
    {
        "*": {
            "turnToConfig": <?= /* @noEscape */ json_encode($initConfig) ?>
        }
    }
</script>


<?php if ($widgetUrl): ?>
    <script src="<?= $block->escapeUrl($widgetUrl) ?>" async></script>
<?php endif; ?>

<?= /** @noEscape */ $block->getChildHtml() ?>
